VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_RESEND_API_KEY=your_resend_api_key

# Server-only (no VITE_ prefix — never bundled into the browser).

# Used by api/chat.js (website widget) and api/facebook-webhook.js
# (Messenger). Same variable name as the old standalone Facebook Bot
# project, so its existing OpenAI key can be reused as-is.
OPENAI_API_KEY=your_openai_api_key

# Used by api/facebook-webhook.js. Values come from the old standalone
# Facebook Bot project (PAGE_ACCESS_TOKEN / VERIFY_TOKEN there) — reuse the
# same values, just under these new names when setting them in Vercel.
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token

# Used by api/_lib/supabaseAdmin.js — powers every Vercel function that
# needs privileged (RLS-bypassing) Supabase access: the Telegram bot,
# check-in/booking notifications, and api/gallery-*.js's admin-session check.
# From Supabase dashboard: Settings -> API. Never expose the service role
# key to the browser.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare R2 (gallery photo storage — see CLOUDFLARE_R2_SETUP.md).
# Used by api/gallery-presign-upload.js and api/gallery-delete.js.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# The bucket's public base URL — either the auto-generated pub-<hash>.r2.dev
# URL or a custom domain you've connected, no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
