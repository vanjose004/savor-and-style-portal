VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_RESEND_API_KEY=your_resend_api_key

# Server-only (no VITE_ prefix — never bundled into the browser). Used by
# api/chat.js for the landing/home page chat widget. Same variable name as
# the old standalone Facebook Bot project, so its existing OpenAI key can be
# reused as-is.
OPENAI_API_KEY=your_openai_api_key
