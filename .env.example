VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_RESEND_API_KEY=your_resend_api_key

# Server-only (no VITE_ prefix — never bundled into the browser).

# Used by api/chat.js (website widget) and api/facebook-webhook.js
# (Messenger). Same variable name as the old standalone Facebook Bot
# project, so its existing OpenAI key can be reused as-is.
OPENAI_API_KEY=your_openai_api_key

# Used by api/facebook-webhook.js. Values come from the old standalone
# Facebook Bot project (PAGE_ACCESS_TOKEN / VERIFY_TOKEN there) — reuse the
# same values, just under these new names when setting them in Vercel.
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token
